# ── Core ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///mehna.db

# ── Security ──────────────────────────────────────────
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_COUNT=0

# ── Google Sign-In (optional but recommended) ──────────
# 1) console.cloud.google.com → APIs & Services → Credentials
# 2) Create an OAuth client ID of type "Web application"
# 3) Authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: set explicitly when the public URL differs from the request URL.
GOOGLE_REDIRECT_URI=

# ── Mail (optional in dev: reset links print to console) ──
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@mehna.iq

# ── Brand ─────────────────────────────────────────────
SITE_NAME=مهنة
SITE_URL=http://localhost:5000
DEFAULT_CURRENCY=IQD
